<?xml version="1.0" encoding="utf-8"?>
<!-- Defines the app's theme for light mode -->
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme, extending MaterialComponents with a dark action bar -->
    <style name="Theme.EdamamApp" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <!-- Primary color variant for status bar, etc. -->
        <item name="colorPrimaryVariant">@color/colorPrimaryDark</item>
        <!-- Text/icon color on primary background -->
        <item name="colorOnPrimary">@android:color/white</item>
        <!-- Secondary brand color for accents -->
        <item name="colorSecondary">@color/colorAccent</item>
        <!-- Secondary color variant -->
        <item name="colorSecondaryVariant">@color/colorAccent</item>
        <!-- Text/icon color on secondary background -->
        <item name="colorOnSecondary">@android:color/black</item>
        <!-- Status bar color, targeting API 21+ -->
        <item name="android:statusBarColor" tools:targetApi="l">?attr/colorPrimaryVariant</item>
        <!-- Custom ActionBar style -->
        <item name="android:actionBarStyle">@style/ActionBarStyle</item>
        <item name="actionBarStyle">@style/ActionBarStyle</item>
    </style>
    <!-- Custom style for the ActionBar -->
    <style name="ActionBarStyle" parent="Widget.MaterialComponents.ActionBar.Solid">
        <!-- ActionBar title text color -->
        <item name="titleTextColor">?android:attr/textColorPrimary</item>
        <!-- ActionBar background color -->
        <item name="background">?attr/colorPrimary</item>
    </style>
</resources>